{
  "name": "packaging-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "validate:functional": "node --import tsx ./src/server/validation/run-functional-validation.ts",
    "validate:pm-only": "node --import tsx ./src/server/validation/run-pm-only-consolidation.ts",
    "validate:pm-plus-altas": "node --import tsx ./src/server/validation/run-pm-material-requests-consolidation.ts",
    "validate:alta-mat-real": "node --import tsx ./src/server/validation/run-alta-mat-real-validation.ts",
    "validate:perpiel-pm-bom": "node --import tsx ./src/server/validation/run-perpiel-pm-bom-validation.ts",
    "validate:perpiel-spray-pm-bom": "node --import tsx ./src/server/validation/run-perpiel-spray-pm-bom-validation.ts",
    "validate:magnesio-pm-bom": "node --import tsx ./src/server/validation/run-magnesio-pm-bom-validation.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
